@page "/"
@inject IJSRuntime JsRuntime
@inject ModalService Modal

<div class="sct-window-frame @(_isMoreOpen ? "more-expanded" : "")">
    <!-- Top Titlebar with Native Drag and Authentic WinForms Gradient & Buttons -->
    <div id="sct-titlebar" class="sct-titlebar">
        <div class="sct-titlebar-left">
            <img src="img/icons/icons8-server-24.png" srcset="img/icons/icons8-server-24.png 1x, img/icons/icons8-server-48 (1).png 2x" class="sct-titlebar-icon" alt="SCT" />
            <span class="sct-titlebar-title">Server Creation Tool 5.2</span>
        </div>
        
        <div class="sct-titlebar-controls" @onmousedown:stopPropagation="true">
            <button type="button" class="sct-win-btn sct-win-btn-min" @onclick="MinimizeWindow" title="Minimize"></button>
            <button type="button" class="sct-win-btn sct-win-btn-close" @onclick="CloseWindow" title="Close"></button>
        </div>
    </div>

    <!-- Main Window Middle with WinForms Docked 10px Borders -->
    <div class="sct-window-inner">
        <!-- Docked Left 10px Gradient Border (WinForms panel4) -->
        <div class="sct-border-left"></div>

        <!-- Center Working Canvas (WinForms Client Area) -->
        <div class="sct-client-area">
            <div class="sct-main-content-wrapper">
                <!-- Top Ribbon Toolbar (WinForms helpInfBar2.png) -->
                <div class="sct-ribbon-bar">
                    <div class="sct-ribbon-left">
                        <button class="sct-ribbon-btn" @onclick="SelectLibraryLocation" title="Choose server installation folder">
                            <img src="img/icons/468.png" class="sct-ribbon-icon" alt="" />
                            <span>Select Server Library<br/>Location</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenSettings" title="Application Settings">
                            <img src="img/icons/settingsBtn.Image.png" class="sct-ribbon-icon" alt="" />
                            <span>Settings</span>
                        </button>

                        <button id="sct-lang-btn" class="sct-ribbon-btn @(_isLangMenuOpen ? "active" : "")" @onclick="ToggleLangMenu" title="Change Language">
                            <img src="img/icons/translate (1)21.png" class="sct-ribbon-icon" alt="" />
                            <span>Language</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenGroupWebsite" title="Steam Community Group">
                            <img src="img/icons/world-wide-web21.png" class="sct-ribbon-icon" alt="" />
                            <span>Tool<br/>Group-Website</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenAbout" title="About">
                            <img src="img/icons/219121.png" class="sct-ribbon-icon" alt="" />
                            <span>About</span>
                        </button>
                    </div>

                    <div class="sct-ribbon-right">
                        <span class="sct-more-label">MORE:</span>
                        <button class="sct-more-btn @(_isMoreOpen ? "open" : "")" @onclick="ToggleMorePanel" title="Toggle More section"></button>
                    </div>
                </div>

                <!-- Lower Canvas: Left Server List + Right Game Details -->
                <div class="sct-workspace">
                    <!-- Left Column: Search Box + Server Selection Panel -->
                    <div class="sct-left-column">
                        <!-- Search Bar Row -->
                        <div class="sct-search-box-row">
                            <label class="sct-search-label">Search:</label>
                            <input type="text" class="sct-search-textbox" @bind="_searchQuery" @bind:event="oninput" />
                            <button class="sct-fav-toggle-btn @(_showFavoritesOnly ? "active" : "")" @onclick="ToggleFavoritesFilter" title="Show favourites only">
                                <img src="@(_showFavoritesOnly ? "img/icons/starChecked 16.png" : "img/icons/starUnChecked gray 16.png")" alt="Favorites" />
                            </button>
                        </div>

                        <!-- Server List Box (WinForms srvPanel.png) -->
                        <div class="sct-server-panel-container">
                            <!-- ---Welcome--- Item -->
                            <button type="button" class="sct-list-item-welcome @(_isWelcomeActive ? "active" : "")" @onclick="SelectWelcome">
                                ---Welcome---
                            </button>

                            <!-- Reload Servers Item -->
                            <button type="button" class="sct-list-item-reload @(_isReloading ? "pressed" : "")" @onclick="ReloadServers">
                                <span>Reload Servers</span>
                                <img src="img/icons/refresh16x161.png" class="sct-reload-icon" alt="Reload" />
                            </button>

                            <!-- Server List Items -->
                            <div class="sct-server-items-scroll">
                                @foreach (var srv in FilteredServers)
                                {
                                    var isSelected = !_isWelcomeActive && SelectedServer?.Id == srv.Id;
                                    <button type="button" class="sct-list-item-srv @(isSelected ? "selected" : "")" @onclick="() => SelectServer(srv)">
                                        <span class="sct-srv-name">@srv.Name</span>
                                        @if (srv.IsFavorite)
                                        {
                                            <img src="img/icons/starChecked 16.png" class="sct-star-icon-small" alt="Favorite" />
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Game Details OR Welcome View -->
                    <div class="sct-right-column">
                        @if (_isWelcomeActive)
                        {
                            <!-- Welcome Screen (WinForms welcomePnl2.png + basicInstrBox) -->
                            <div class="sct-welcome-container">
                                <div class="sct-welcome-banner">
                                    <h2 class="sct-welcome-headline">Welcome to Server Creation Tool 5.0</h2>
                                    <p class="sct-welcome-subtext">
                                        This tool allows you to download, install and manage<br />
                                        steam and non-steam servers quick and easy.
                                    </p>
                                </div>

                                <div class="sct-donate-row">
                                    <button class="sct-donate-button" @onclick="OpenDonate" title="Support development via PayPal"></button>
                                </div>

                                <div class="sct-instructions-card">
                                    <div class="sct-instructions-header">Basic Instructions:</div>
                                    <div class="sct-instructions-text-area">
                                        <p>1) Select the game you want and click the "Install Server" button.</p>
                                        <p>2) If its the first time you're installing a server, select the installation folder, and then wait for it to finish.</p>
                                        <p>3) Type "quit" in the command line after the installation has finished. - (only for steam servers)</p>
                                        <p>4) Configure the server the way you like by editing the settings files (optional).</p>
                                        <p>5) Start the server and enjoy!</p>
                                        <p style="margin-top: 8px; color: #a0aec0;">
                                            NOTE: If you need extra help, some servers include a guide in the "Extra" section.<br />
                                            You can also go to the "Language" or "About" options for additional help, or join our Steam / Discord communities!
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (SelectedServer != null)
                        {
                            <!-- Main Server Panel (WinForms mainPanel.png) -->
                            <div class="sct-main-srv-panel">
                                <!-- Server Name / Instance Dropdown -->
                                <div class="sct-srv-header-row">
                                    <button type="button" class="sct-instance-dropdown-btn @(_isInstanceMenuOpen ? "active" : "")" @onclick="ToggleInstanceMenu" @onclick:stopPropagation="true">
                                        <span>@SelectedServer.Name</span>
                                        <span class="sct-caret">▼</span>
                                    </button>

                                    @if (_isInstanceMenuOpen)
                                    {
                                        <div class="sct-instances-popup" @onclick:stopPropagation="true">
                                            @foreach (var inst in SelectedServer.Instances)
                                            {
                                                <button type="button" class="sct-instance-option @(SelectedServer.CurrentInstance == inst ? "active" : "")" @onclick="() => SwitchInstance(inst)">
                                                    <img class="sct-context-menu-icon" src="img/icons/icons8-dot-24.png" alt="" />
                                                    <span>@inst</span>
                                                </button>
                                            }
                                            <div class="sct-popup-divider"></div>
                                            <button type="button" class="sct-instance-option" @onclick="AddNewInstance">
                                                <img class="sct-context-menu-icon" src="img/icons/refresh16x161.png" style="width: 14px; height: 14px;" alt="" />
                                                <span>Add New Instance...</span>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Center Game Logo Area (Takes free space, no circle frame) -->
                                <div class="sct-center-logo-area">
                                    <img src="@SelectedServer.LogoUrl" class="sct-logo-img" alt="@SelectedServer.Name" @onerror="OnLogoError" />
                                </div>

                                <!-- Control Bar (WinForms instBtnAndInfBar2.png) -->
                                <div class="sct-control-bar-panel">
                                    @if (SelectedServer.IsInstalled)
                                    {
                                        <button type="button" class="sct-srv-action-btn state-start" @onclick="StartServer">
                                            <img src="img/icons/start_img.png" class="sct-srv-btn-icon" alt="" />
                                            <span class="sct-srv-btn-text">Start</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="sct-srv-action-btn state-install" @onclick="InstallServer">
                                            <img src="img/icons/install_img.png" class="sct-srv-btn-icon" alt="" />
                                            <span class="sct-srv-btn-text">Install</span>
                                        </button>
                                    }

                                    <div class="sct-size-display">
                                        <span class="sct-size-lbl-top">-SIZE-</span>
                                        <span class="sct-size-lbl-val">@SelectedServer.Size</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(SelectedServer.LastRan) && SelectedServer.LastRan != "Never")
                                    {
                                        <div class="sct-size-display" style="margin-left: 8px;">
                                            <span class="sct-size-lbl-top">-LAST RAN-</span>
                                            <span class="sct-size-lbl-val" style="font-size: 10px;">@SelectedServer.LastRan</span>
                                        </div>
                                    }

                                    <div class="sct-quick-buttons">
                                        <button type="button" class="sct-quick-icon-btn" @onclick="ToggleFavorite" title="Add to favourites">
                                            <img src="@(SelectedServer.IsFavorite ? "img/icons/starChecked.png" : "img/icons/starUnChecked.png")" alt="Star" />
                                        </button>

                                        <button type="button" class="sct-quick-icon-btn" @onclick="OpenServerInfo" title="Info">
                                            <img src="img/icons/srvInfBtn.BackgroundImage.png" alt="Info" />
                                        </button>
                                    </div>
                                </div>

                                <!-- Lower Two Panels: -Extra- and -Actions- -->
                                <div class="sct-lower-panels-row">
                                    <!-- -Extra- Panel (WinForms extrPnl.png) -->
                                    <div class="sct-sub-panel sct-extra-panel">
                                        <div class="sct-sub-panel-title">-Extra-</div>
                                        <div class="sct-sub-panel-links">
                                            @if (SelectedServer.HasGuide)
                                            {
                                                <button type="button" class="sct-action-link" @onclick="OpenInstallationGuide">
                                                    <img src="img/icons/1091.png" class="sct-action-link-icon" alt="Guide" />
                                                    <span class="sct-action-link-text">Installation Guide</span>
                                                </button>
                                            }

                                            @if (SelectedServer.HasCustomBatch)
                                            {
                                                <button type="button" class="sct-action-link" @onclick="CreateCustomBatch">
                                                    <span class="sct-action-link-text">Create custom start batch file</span>
                                                </button>
                                            }

                                            @if (SelectedServer.HasCustomConfig)
                                            {
                                                <button type="button" class="sct-action-link" @onclick="CreateCustomConfig">
                                                    <span class="sct-action-link-text">Create custom config file</span>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <!-- -Actions- Panel (WinForms actPnl.png) -->
                                    <div class="sct-sub-panel sct-actions-panel">
                                        <div class="sct-sub-panel-title">-Actions-</div>
                                        <div class="sct-sub-panel-links">
                                            <button type="button" class="sct-action-link" @onclick="OpenFolder" disabled="@(!SelectedServer.IsInstalled)">
                                                <img src="img/icons/468.png" class="sct-action-link-icon" alt="Folder" />
                                                <span class="sct-action-link-text">Open Folder</span>
                                            </button>

                                            <button type="button" class="sct-action-link" @onclick="UpdateOrRepair">
                                                <img src="img/icons/icons8-rotate2-24.png" class="sct-action-link-icon" alt="Update" />
                                                <span class="sct-action-link-text">Update/Repair</span>
                                            </button>

                                            <button type="button" class="sct-action-link" @onclick="DeleteServer" disabled="@(!SelectedServer.IsInstalled)">
                                                <img src="img/icons/1263.png" class="sct-action-link-icon" alt="Delete" />
                                                <span class="sct-action-link-text">Delete</span>
                                            </button>

                                            <button id="sct-edit-settings-btn" type="button" class="sct-action-link @(_isEditSettingsMenuOpen ? "active" : "")" @onclick="ToggleEditSettingsMenu" disabled="@(!SelectedServer.IsInstalled)">
                                                <img src="img/icons/1645.png" class="sct-action-link-icon" alt="Settings" />
                                                <span class="sct-action-link-text">Edit Settings</span>
                                                <span class="sct-caret-small">▼</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- MORE Sidebar Panel (WinForms extraPnl.png) sits fixed at x=607 in the client area; window grows outwards to reveal it -->
            <div class="sct-more-sidebar-panel">
                <button class="sct-side-btn" @onclick="OpenAppLogs">
                    <img src="img/icons/62221.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">App<br/>Logs</span>
                </button>

                <button id="sct-steamcmd-btn" class="sct-side-btn @(_isSteamCmdMenuOpen ? "active" : "")" @onclick="ToggleSteamCmdMenu">
                    <img src="img/icons/cmd_icon21.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">SteamCMD<br/>options ▼</span>
                </button>

                <button class="sct-side-btn" @onclick="OpenPlannedFeatures">
                    <img src="img/icons/pencil21.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">Planned<br/>Features</span>
                </button>

                <button class="sct-side-btn" @onclick="OpenFAQ">
                    <img src="img/icons/faqBtn.Image.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">FAQ</span>
                </button>

                <button class="sct-side-btn" @onclick="OpenPortForwardGuide">
                    <img src="img/icons/port.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">How to port<br/>forward</span>
                </button>

                <button class="sct-side-btn" @onclick='() => OpenLink("https://discord.gg/79eKCs5fW8")'>
                    <img src="img/icons/discordSrvBtn.Image.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">Discord<br/>Server</span>
                </button>

                <button class="sct-side-btn" @onclick='() => OpenLink("https://github.com/Zeromix9/Server-Creation-Tool")'>
                    <img src="img/icons/github_logo.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">Github</span>
                </button>

                <button class="sct-side-btn" @onclick="CheckForUpdates">
                    <img src="img/icons/chck4UpdtBtn.Image.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">Check<br/>for updates</span>
                </button>
            </div>
        </div>

        <!-- Docked Right 10px Gradient Border (WinForms panel3) -->
        <div class="sct-border-right"></div>
    </div>

    <!-- Docked Bottom 10px Gradient Border (WinForms panel2) -->
    <div class="sct-border-bottom"></div>

    @if (_isLangMenuOpen || _isSteamCmdMenuOpen || _isInstanceMenuOpen || _isEditSettingsMenuOpen)
    {
        <div class="sct-context-backdrop" @onclick="CloseContextMenus"></div>
    }

    @if (_isLangMenuOpen)
    {
        <div class="sct-custom-context-menu" style="top: @($"{_langMenuTop}px"); left: @($"{_langMenuLeft}px");" @onclick:stopPropagation="true">
            <button class="sct-context-menu-item @(_currentLang == "en" ? "selected" : "")" @onclick='() => SelectLanguage("en")'>
                <img class="sct-context-menu-icon" src="img/icons/icons8-great-britain-24.png" alt="" />
                <span>English</span>
            </button>
            <div class="sct-context-menu-separator"></div>
            <button class="sct-context-menu-item @(_currentLang == "de" ? "selected" : "")" @onclick='() => SelectLanguage("de")'>
                <img class="sct-context-menu-icon" src="img/icons/icons8-germany-24.png" alt="" />
                <span>German</span>
            </button>
        </div>
    }

    @if (_isSteamCmdMenuOpen)
    {
        <div class="sct-custom-context-menu" style="top: @($"{_steamCmdMenuTop}px"); right: @($"{_steamCmdMenuRight}px");" @onclick:stopPropagation="true">
            <button class="sct-context-menu-item" @onclick="ExecuteSteamCmdStart">
                <img class="sct-context-menu-icon" src="img/icons/SquaregreenArrowRight.png" alt="" />
                <span>Start</span>
            </button>
            <div class="sct-context-menu-separator"></div>
            <button class="sct-context-menu-item" @onclick="ExecuteSteamCmdClearCache">
                <img class="sct-context-menu-icon" src="img/icons/x1616.png" alt="" />
                <span>Clear Cache</span>
            </button>
        </div>
    }

    @if (_isEditSettingsMenuOpen && SelectedServer != null)
    {
        var menuStyle = _isEditSettingsMenuUpward
            ? $"bottom: {_editSettingsMenuBottom}px; left: {_editSettingsMenuLeft}px;"
            : $"top: {_editSettingsMenuTop}px; left: {_editSettingsMenuLeft}px;";

        <div class="sct-custom-context-menu" style="@menuStyle" @onclick:stopPropagation="true">
            @if (SelectedServer.ConfigFiles != null && SelectedServer.ConfigFiles.Count > 0)
            {
                @for (int i = 0; i < SelectedServer.ConfigFiles.Count; i++)
                {
                    var file = SelectedServer.ConfigFiles[i];
                    var isLast = i == SelectedServer.ConfigFiles.Count - 1;
                    <button type="button" class="sct-context-menu-item" @onclick="() => EditConfigFile(file)">
                        <img class="sct-context-menu-icon" src="img/icons/1645.png" alt="" />
                        <span>Edit @file</span>
                    </button>
                    @if (!isLast)
                    {
                        <div class="sct-context-menu-separator"></div>
                    }
                }
            }
            else
            {
                <div class="sct-context-menu-item" style="color: #8a96a3; cursor: default;">
                    <span>No config files found</span>
                </div>
            }
        </div>
    }
</div>

