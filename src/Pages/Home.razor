    private bool _isReloading = false;

    private async Task ReloadServers()
    {
        _isReloading = true;
        InitializeServers();
        if (SelectedServer != null)
        {
            SelectedServer = _servers.FirstOrDefault(s => s.Id == SelectedServer.Id) ?? _servers.FirstOrDefault();
        }
        await Task.Delay(200);
        _isReloading = false;
    }

