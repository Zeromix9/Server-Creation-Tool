                                                    <div class="sct-auto-row-split">
                                                        <span class="sct-auto-field-label">Scheduled Restart:</span>
                                                        <select class="sct-auto-select" @bind="SelectedServer.ScheduledRestart" title="Periodic automated restart schedule">
                                                            <option value="Disabled">Disabled</option>
                                                            <option value="Every 6 Hours">Every 6 Hours</option>
                                                            <option value="Every 12 Hours">Every 12 Hours</option>
                                                            <option value="Daily (04:00 AM)">Daily (04:00 AM)</option>
                                                            <option value="Every 48 Hours">Every 48 Hours</option>
                                                        </select>
                                                    </div>

                                                    <div style="margin-top: 6px;">
                                                        <label class="sct-checkbox-label" title="Check and validate server updates before starting">
                                                            <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.UpdateOnLaunch" />
                                                            <span class="sct-check-title">Check &amp; update files before launch</span>
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

