@page "/"
@inject IJSRuntime JsRuntime
@inject ModalService Modal

<div class="sct-window-frame @(_isMoreOpen ? "more-expanded" : "")">
    <!-- Top Titlebar with Native Drag and Authentic WinForms Gradient & Buttons -->
    <div id="sct-titlebar" class="sct-titlebar">
        <div class="sct-titlebar-left">
            <img src="img/icons/icons8-server-24.png" srcset="img/icons/icons8-server-24.png 1x, img/icons/icons8-server-48 (1).png 2x" class="sct-titlebar-icon" alt="SCT" />
            <span class="sct-titlebar-title">Server Creation Tool 5.2</span>
        </div>
        
        <div class="sct-titlebar-controls" @onmousedown:stopPropagation="true">
            <button type="button" class="sct-win-btn sct-win-btn-min" @onclick="MinimizeWindow" title="Minimize"></button>
            <button type="button" class="sct-win-btn sct-win-btn-close" @onclick="CloseWindow" title="Close"></button>
        </div>
    </div>

    <!-- Main Window Middle with WinForms Docked 10px Borders -->
    <div class="sct-window-inner">
        <!-- Docked Left 10px Gradient Border (WinForms panel4) -->
        <div class="sct-border-left"></div>

        <!-- Center Working Canvas (WinForms Client Area) -->
        <div class="sct-client-area">
            <div class="sct-main-content-wrapper">
                <!-- Top Ribbon Toolbar (WinForms helpInfBar2.png) -->
                <div class="sct-ribbon-bar">
                    <div class="sct-ribbon-left">
                        <button class="sct-ribbon-btn" @onclick="SelectLibraryLocation" title="Choose server installation folder">
                            <img src="img/icons/468.png" class="sct-ribbon-icon" alt="" />
                            <span>Select Server Library<br/>Location</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenSettings" title="Application Settings">
                            <img src="img/icons/settingsBtn.Image.png" class="sct-ribbon-icon" alt="" />
                            <span>Settings</span>
                        </button>

                        <button id="sct-lang-btn" class="sct-ribbon-btn @(_isLangMenuOpen ? "active" : "")" @onclick="ToggleLangMenu" title="Change Language">
                            <img src="img/icons/translate (1)21.png" class="sct-ribbon-icon" alt="" />
                            <span>Language</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenGroupWebsite" title="Steam Community Group">
                            <img src="img/icons/world-wide-web21.png" class="sct-ribbon-icon" alt="" />
                            <span>Tool<br/>Group-Website</span>
                        </button>

                        <button class="sct-ribbon-btn" @onclick="OpenAbout" title="About">
                            <img src="img/icons/219121.png" class="sct-ribbon-icon" alt="" />
                            <span>About</span>
                        </button>
                    </div>

                    <div class="sct-ribbon-right">
                        <span class="sct-more-label">MORE:</span>
                        <button class="sct-more-btn @(_isMoreOpen ? "open" : "")" @onclick="ToggleMorePanel" title="Toggle More section"></button>
                    </div>
                </div>

                <!-- Lower Canvas: Left Server List + Right Game Details -->
                <div class="sct-workspace">
                    <!-- Left Column: Search Box + Server Selection Panel -->
                    <div class="sct-left-column">
                        <!-- Search Bar Row -->
                        <div class="sct-search-box-row">
                            <label class="sct-search-label">Search:</label>
                            <input type="text" class="sct-search-textbox" @bind="_searchQuery" @bind:event="oninput" />
                            <button class="sct-fav-toggle-btn @(_showFavoritesOnly ? "active" : "")" @onclick="ToggleFavoritesFilter" title="Show favourites only">
                                <img src="@(_showFavoritesOnly ? "img/icons/starChecked 16.png" : "img/icons/starUnChecked gray 16.png")" alt="Favorites" />
                            </button>
                        </div>

                        <!-- Server List Box (WinForms srvPanel.png) -->
                        <div class="sct-server-panel-container">
                            <!-- ---Welcome--- Item -->
                            <button type="button" class="sct-list-item-welcome @(_isWelcomeActive ? "active" : "")" @onclick="SelectWelcome">
                                ---Welcome---
                            </button>

                            <!-- Reload Servers Item -->
                            <button type="button" class="sct-list-item-reload @(_isReloading ? "pressed" : "")" @onclick="ReloadServers">
                                <span>Reload Servers</span>
                                <img src="img/icons/refresh16x161.png" class="sct-reload-icon" alt="Reload" />
                            </button>

                            <!-- Server List Items -->
                            <div class="sct-server-items-scroll">
                                @foreach (var srv in FilteredServers)
                                {
                                    var isSelected = !_isWelcomeActive && SelectedServer?.Id == srv.Id;
                                    <button type="button" class="sct-list-item-srv @(isSelected ? "selected" : "")" @onclick="() => SelectServer(srv)">
                                        <span class="sct-srv-name">@srv.Name</span>
                                        @if (srv.IsFavorite)
                                        {
                                            <img src="img/icons/starChecked 16.png" class="sct-star-icon-small" alt="Favorite" />
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Game Details OR Welcome View -->
                    <div class="sct-right-column">
                        @if (_isWelcomeActive)
                        {
                            <!-- Welcome Screen (WinForms welcomePnl2.png + basicInstrBox) -->
                            <div class="sct-welcome-container">
                                <div class="sct-welcome-banner">
                                    <h2 class="sct-welcome-headline">Welcome to Server Creation Tool 5.0</h2>
                                    <p class="sct-welcome-subtext">
                                        This tool allows you to download, install and manage<br />
                                        steam and non-steam servers quick and easy.
                                    </p>
                                </div>

                                <div class="sct-donate-row">
                                    <button class="sct-donate-button" @onclick="OpenDonate" title="Support development via PayPal"></button>
                                </div>

                                <div class="sct-instructions-card">
                                    <div class="sct-instructions-header">Basic Instructions:</div>
                                    <div class="sct-instructions-text-area">
                                        <p>1) Select the game you want and click the "Install Server" button.</p>
                                        <p>2) If its the first time you're installing a server, select the installation folder, and then wait for it to finish.</p>
                                        <p>3) Type "quit" in the command line after the installation has finished. - (only for steam servers)</p>
                                        <p>4) Configure the server the way you like by editing the settings files (optional).</p>
                                        <p>5) Start the server and enjoy!</p>
                                        <p style="margin-top: 8px; color: #a0aec0;">
                                            NOTE: If you need extra help, some servers include a guide in the "Extra" section.<br />
                                            You can also go to the "Language" or "About" options for additional help, or join our Steam / Discord communities!
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (SelectedServer != null)
                        {
                            <!-- Main Server Panel (Tabbed with Authentic Centered Logo & Control Bar) -->
                            <div class="sct-main-srv-panel">
                                <!-- Server Name / Instance Dropdown -->
                                <div class="sct-srv-header-row">
                                    <button type="button" class="sct-instance-dropdown-btn @(_isInstanceMenuOpen ? "active" : "")" @onclick="ToggleInstanceMenu" @onclick:stopPropagation="true">
                                        <span>@SelectedServer.Name</span>
                                        <span class="sct-instance-badge">[@SelectedServer.CurrentInstance]</span>
                                        <span class="sct-caret">▼</span>
                                    </button>

                                    @if (_isInstanceMenuOpen)
                                    {
                                        <div class="sct-instances-popup" @onclick:stopPropagation="true">
                                            @foreach (var inst in SelectedServer.Instances)
                                            {
                                                <button type="button" class="sct-instance-option @(SelectedServer.CurrentInstance == inst ? "active" : "")" @onclick="() => SwitchInstance(inst)">
                                                    <img class="sct-context-menu-icon" src="img/icons/icons8-dot-24.png" alt="" />
                                                    <span>@inst</span>
                                                </button>
                                            }
                                            <div class="sct-popup-divider"></div>
                                            <button type="button" class="sct-instance-option" @onclick="AddNewInstance">
                                                <img class="sct-context-menu-icon" src="img/icons/refresh16x161.png" style="width: 14px; height: 14px;" alt="" />
                                                <span>Add New Instance...</span>
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Center Game Logo Area (Takes free space, no circle frame) -->
                                <div class="sct-center-logo-area">
                                    <img src="@SelectedServer.LogoUrl" class="sct-logo-img" alt="@SelectedServer.Name" @onerror="OnLogoError" />
                                </div>

                                <!-- Control Bar (WinForms instBtnAndInfBar2.png) -->
                                <div class="sct-control-bar-panel">
                                    @if (SelectedServer.IsInstalled)
                                    {
                                        <button type="button" class="sct-srv-action-btn @(SelectedServer.IsRunning ? "state-stop" : "state-start")" @onclick="StartServer">
                                            <img src="@(SelectedServer.IsRunning ? "img/icons/icons8-stop-24.png" : "img/icons/start_img.png")" class="sct-srv-btn-icon" alt="" />
                                            <span class="sct-srv-btn-text">@(SelectedServer.IsRunning ? "Stop" : "Start")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="sct-srv-action-btn state-install" @onclick="InstallServer">
                                            <img src="img/icons/install_img.png" class="sct-srv-btn-icon" alt="" />
                                            <span class="sct-srv-btn-text">Install</span>
                                        </button>
                                    }

                                    <div class="sct-size-display">
                                        <span class="sct-size-lbl-top">-STATUS-</span>
                                        <span class="sct-size-lbl-val" style="color: @(SelectedServer.IsRunning ? "#4ade80" : SelectedServer.IsInstalled ? "#38bdf8" : "#94a3b8");">
                                            @(SelectedServer.IsRunning ? "Running" : SelectedServer.IsInstalled ? "Ready" : "Uninstalled")
                                        </span>
                                    </div>

                                    <div class="sct-size-display">
                                        <span class="sct-size-lbl-top">-SIZE-</span>
                                        <span class="sct-size-lbl-val">@SelectedServer.Size</span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(SelectedServer.LastRan) && SelectedServer.LastRan != "Never")
                                    {
                                        <div class="sct-size-display" style="margin-left: 4px;">
                                            <span class="sct-size-lbl-top">-LAST RAN-</span>
                                            <span class="sct-size-lbl-val" style="font-size: 8.75pt;">@SelectedServer.LastRan</span>
                                        </div>
                                    }

                                    <div class="sct-quick-buttons">
                                        <button type="button" class="sct-quick-icon-btn" @onclick="ToggleFavorite" title="Add to favourites">
                                            <img src="@(SelectedServer.IsFavorite ? "img/icons/starChecked.png" : "img/icons/starUnChecked.png")" alt="Star" />
                                        </button>

                                        <button type="button" class="sct-quick-icon-btn" @onclick="OpenServerInfo" title="Info">
                                            <img src="img/icons/srvInfBtn.BackgroundImage.png" alt="Info" />
                                        </button>
                                    </div>
                                </div>

                                <!-- Retro Property Sheet Tab Strip -->
                                <div class="sct-tab-strip">
                                    <button type="button" class="sct-tab-btn @(_activeTab == "general" ? "active" : "")" @onclick='() => SetActiveTab("general")'>
                                        <img src="img/icons/icons8-server-24.png" class="sct-tab-icon" alt="" />
                                        <span>Overview</span>
                                    </button>
                                    <button type="button" class="sct-tab-btn @(_activeTab == "tools" ? "active" : "")" @onclick='() => SetActiveTab("tools")'>
                                        <img src="img/icons/1645.png" class="sct-tab-icon" alt="" />
                                        <span>Tools &amp; Maintenance</span>
                                    </button>
                                    <button type="button" class="sct-tab-btn @(_activeTab == "settings" ? "active" : "")" @onclick='() => SetActiveTab("settings")'>
                                        <img src="img/icons/settingsBtn.Image.png" class="sct-tab-icon" alt="" />
                                        <span>Settings</span>
                                    </button>
                                    <button type="button" class="sct-tab-btn @(_activeTab == "automation" ? "active" : "")" @onclick='() => SetActiveTab("automation")'>
                                        <img src="img/icons/cmd_icon21.png" class="sct-tab-icon" alt="" />
                                        <span>Automation &amp; Watchdog</span>
                                    </button>
                                </div>

                                <!-- Tab Content Canvas -->
                                <div class="sct-tab-content">
                                    @if (_activeTab == "general")
                                    {
                                        <!-- TAB 1: Overview -->
                                        <div class="sct-tab-pane">
                                            @if (!_isTerminalExpanded)
                                            {
                                                <!-- Server Overview Card -->
                                                <div class="sct-general-status-card">
                                                    <div class="sct-card-section-title">-Server Overview-</div>
                                                    <div class="sct-status-meta-grid">
                                                        <div class="sct-meta-entry">
                                                            <span class="sct-entry-label">Lifecycle State:</span>
                                                            <span class="sct-entry-value">@(SelectedServer.IsRunning ? "Active Process (Running)" : SelectedServer.IsInstalled ? "Installed & Ready" : "Uninstalled")</span>
                                                        </div>
                                                        <div class="sct-meta-entry">
                                                            <span class="sct-entry-label">Storage Footprint:</span>
                                                            <span class="sct-entry-value">@SelectedServer.Size</span>
                                                        </div>
                                                        <div class="sct-meta-entry">
                                                            <span class="sct-entry-label">Last Execution:</span>
                                                            <span class="sct-entry-value">@SelectedServer.LastRan</span>
                                                        </div>
                                                        <div class="sct-meta-entry">
                                                            <span class="sct-entry-label">Last Updated:</span>
                                                            <span class="sct-entry-value">@SelectedServer.LastUpdated</span>
                                                        </div>
                                                        <div class="sct-meta-entry">
                                                            <span class="sct-entry-label">Active Instance:</span>
                                                            <span class="sct-entry-value">@SelectedServer.CurrentInstance</span>
                                                        </div>
                                                        <div class="sct-meta-entry full-span">
                                                            <span class="sct-entry-label">Install Location:</span>
                                                            <span class="sct-entry-value path" title="@_settings.ServerLibraryPath\@SelectedServer.Id">@_settings.ServerLibraryPath\@SelectedServer.Id</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            }

                                            <!-- Terminal Output -->
                                            <div class="sct-terminal-wrapper @(_isTerminalExpanded ? "expanded" : "")">
                                                <textarea class="sct-terminal-output"
                                                          readonly
                                                          placeholder="Terminal output will appear here...">@SelectedServer.TerminalOutput</textarea>
                                                <button type="button"
                                                        class="sct-terminal-expand-btn"
                                                        @onclick="ToggleTerminalExpand"
                                                        title="@(_isTerminalExpanded ? "Restore overview layout" : "Expand terminal output")"
                                                        aria-label="@(_isTerminalExpanded ? "Restore overview layout" : "Expand terminal output")">
                                                    @if (_isTerminalExpanded)
                                                    {
                                                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                                                            <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                        </svg>
                                                    }
                                                    else
                                                    {
                                                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                                                            <path d="M2 6.5L5 3.5L8 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                                                        </svg>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    else if (_activeTab == "tools")
                                    {
                                        <!-- TAB 2: Tools & Maintenance -->
                                        <div class="sct-tab-pane">
                                            <!-- General Section -->
                                            <div class="sct-tools-section-card">
                                                <div class="sct-card-section-title">-General-</div>
                                                <div class="sct-tools-row-3">
                                                    <button type="button" class="sct-tool-btn" @onclick="UpdateOrRepair" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <img src="img/icons/icons8-rotate2-24.png" class="sct-tool-btn-icon" alt="" />
                                                        <span class="sct-tool-btn-text">Update</span>
                                                    </button>
                                                    <button type="button" class="sct-tool-btn" @onclick="DeleteServer" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <img src="img/icons/1263.png" class="sct-tool-btn-icon" alt="" />
                                                        <span class="sct-tool-btn-text">Delete</span>
                                                    </button>
                                                    <button type="button" class="sct-tool-btn" @onclick="OpenFolder" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <img src="img/icons/468.png" class="sct-tool-btn-icon" alt="" />
                                                        <span class="sct-tool-btn-text">Open Folder</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Backups Section -->
                                            <div class="sct-tools-section-card">
                                                <div class="sct-card-section-title">-Backups-</div>
                                                <div class="sct-tools-row-2">
                                                    <button type="button" class="sct-tool-btn" @onclick="BackupServer" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <span style="font-size: 12px; margin-right: 2px;">💾</span>
                                                        <span class="sct-tool-btn-text">Backup Server</span>
                                                    </button>
                                                    <button type="button" class="sct-tool-btn" @onclick="RestoreBackup" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <span style="font-size: 12px; margin-right: 2px;">📦</span>
                                                        <span class="sct-tool-btn-text">Restore Backup</span>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Extra Section -->
                                            <div class="sct-tools-section-card">
                                                <div class="sct-card-section-title">-Extra-</div>
                                                <div class="sct-tools-row-2">
                                                    <button type="button" class="sct-tool-btn" @onclick="CreateCustomBatch" disabled="@(!SelectedServer?.IsInstalled ?? true)">
                                                        <img src="img/icons/SquaregreenArrowRightBatch.png" class="sct-tool-btn-icon" alt="" />
                                                        <span class="sct-tool-btn-text">Create Custom Batch File</span>
                                                    </button>
                                                    <button type="button" class="sct-tool-btn" @onclick="OpenInstallationGuide" disabled="@(SelectedServer == null)">
                                                        <img src="img/icons/1091.png" class="sct-tool-btn-icon" alt="" />
                                                        <span class="sct-tool-btn-text">Manual Installation Guide</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (_activeTab == "settings")
                                    {
                                        <!-- TAB 3: Settings -->
                                        <div class="sct-tab-pane">
                                            <!-- Settings Section -->
                                            <div class="sct-settings-card">
                                                <div class="sct-card-section-title">-Settings-</div>
                                                <div class="sct-settings-body">
                                                    @if (SelectedServer == null)
                                                    {
                                                        <div class="sct-auto-hint" style="padding: 4px 0;">Select a server to view and configure its settings.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="sct-settings-checkboxes-grid">
                                                            <label class="sct-checkbox-label" title="Run the server executable with elevated Administrator privileges">
                                                                <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.RunAsAdmin" />
                                                                <span class="sct-check-title">Run as Administrator</span>
                                                            </label>

                                                            <label class="sct-checkbox-label" title="Assign High CPU process priority to the dedicated server process">
                                                                <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.HighPriority" />
                                                                <span class="sct-check-title">High CPU Priority</span>
                                                            </label>

                                                            <label class="sct-checkbox-label" title="Show interactive command prompt console window for server log and rcon">
                                                                <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.EnableConsoleWindow" />
                                                                <span class="sct-check-title">Enable Console Window</span>
                                                            </label>

                                                            <label class="sct-checkbox-label" title="Automatically create a backup of save and world data before launching">
                                                                <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.AutoBackupBeforeLaunch" />
                                                                <span class="sct-check-title">Backup Saves on Launch</span>
                                                            </label>
                                                        </div>

                                                        <div class="sct-settings-fields-grid">
                                                            <div class="sct-settings-field-row">
                                                                <span class="sct-auto-field-label">Server Port:</span>
                                                                <input type="number" class="sct-settings-input" style="max-width: 120px;" @bind="SelectedServer.ServerPort" min="1024" max="65535" />
                                                                <span class="sct-auto-field-label" style="width: auto; margin-left: 12px;">Max Players:</span>
                                                                <input type="number" class="sct-settings-input" style="max-width: 80px;" @bind="SelectedServer.MaxPlayers" min="1" max="128" />
                                                            </div>
                                                        </div>

                                                        <div class="sct-settings-buttons-bar">
                                                            <button type="button" class="sct-tool-btn" @onclick="SaveServerSettings">
                                                                <span class="sct-tool-btn-text">💾 Save Settings</span>
                                                            </button>
                                                            <button type="button" class="sct-tool-btn" @onclick="ResetServerSettings">
                                                                <span class="sct-tool-btn-text">↺ Reset Server Defaults</span>
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            </div>

                                            <!-- Manually Edit config files: Section -->
                                            <div class="sct-settings-card">
                                                <div class="sct-card-section-title">-Manually Edit config files:-</div>
                                                <div class="sct-config-files-container">
                                                    @if (SelectedServer == null)
                                                    {
                                                        <div class="sct-auto-hint" style="padding: 4px 0;">Please select a server to view its configuration files.</div>
                                                    }
                                                    else if (!SelectedServer.IsInstalled)
                                                    {
                                                        <div class="sct-auto-hint" style="padding: 4px 0;">Server is not installed. Install it first to edit its configuration files.</div>
                                                    }
                                                    else if (SelectedServer.ConfigFiles == null || SelectedServer.ConfigFiles.Count == 0)
                                                    {
                                                        <div class="sct-auto-hint" style="padding: 4px 0;">No configuration files configured for @SelectedServer.Name.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="sct-config-files-grid">
                                                            @foreach (var file in SelectedServer.ConfigFiles)
                                                            {
                                                                <button type="button" class="sct-config-file-row-btn" @onclick="() => EditConfigFile(file)" title="Open @file in default text editor">
                                                                    <img src="img/icons/1645.png" class="sct-config-file-icon" alt="" />
                                                                    <span class="sct-config-file-name">@file</span>
                                                                    <span class="sct-config-file-action">Edit ↗</span>
                                                                </button>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (_activeTab == "automation")
                                    {
                                        <!-- TAB 3: Automation & Watchdog -->
                                        <div class="sct-tab-pane">
                                            <div class="sct-auto-card">
                                                <div class="sct-card-section-title">-Process &amp; Crash Watchdog-</div>
                                                <div class="sct-auto-card-body">
                                                    <label class="sct-checkbox-label" title="Automatically relaunch server if the process terminates or crashes unexpectedly">
                                                        <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.AutoRestartOnCrash" />
                                                        <span class="sct-check-title">Auto-restart server on crash</span>
                                                    </label>
                                                    <div class="sct-auto-hint">Monitors the server process PID and restarts it immediately if an abnormal exit occurs.</div>
                                                </div>
                                            </div>

                                            <div class="sct-auto-card">
                                                <div class="sct-card-section-title">-Config File Watcher-</div>
                                                <div class="sct-auto-card-body">
                                                    <div class="sct-auto-row-split">
                                                        <label class="sct-checkbox-label" title="Restart server when monitored config file is updated">
                                                            <input type="checkbox" class="sct-win-checkbox" @bind="SelectedServer.AutoRestartOnConfigChange" />
                                                            <span class="sct-check-title">Restart on config edit:</span>
                                                        </label>
                                                        @if (SelectedServer.ConfigFiles.Count > 0)
                                                        {
                                                            <select class="sct-auto-select" @bind="SelectedServer.WatchedConfigFile" disabled="@(!SelectedServer.AutoRestartOnConfigChange)" title="Select file to monitor">
                                                                @foreach (var cfg in SelectedServer.ConfigFiles)
                                                                {
                                                                    <option value="@cfg">@cfg</option>
                                                                }
                                                            </select>
                                                        }
                                                    </div>
                                                    <div class="sct-auto-hint">Detects disk write events to the selected configuration file and triggers a graceful reboot.</div>
                                                </div>
                                            </div>

                                            <div class="sct-auto-card">
                                                <div class="sct-card-section-title">-Automated Schedules &amp; Updates-</div>
