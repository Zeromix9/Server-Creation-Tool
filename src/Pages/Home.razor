    private async Task ToggleEditSettingsMenu()
    {
        _isLangMenuOpen = false;
        _isSteamCmdMenuOpen = false;
        _isInstanceMenuOpen = false;

        if (SelectedServer == null) return;

        try
        {
            var rect = await JsRuntime.InvokeAsync<BoundingClientRect>("sctGetElementRect", "#sct-edit-settings-btn");
            if (rect != null && rect.Bottom > 0)
            {
                // Native OS context menu pops up at the bottom of the button and grows outside the form
                var shown = await JsRuntime.InvokeAsync<bool>(
                    "sctShowContextMenu",
                    rect.Left,
                    rect.Bottom,
                    SelectedServer.ConfigFiles,
                    _settings.ServerLibraryPath,
                    SelectedServer.Id
                );

                if (shown)
                {
                    _isEditSettingsMenuOpen = false;
                    return;
                }

                // Fallback for browser mode
                _editSettingsMenuTop = rect.Bottom;
                _editSettingsMenuLeft = rect.Left;
            }
        }
        catch { }

        _isEditSettingsMenuOpen = !_isEditSettingsMenuOpen;
    }

    private async Task EditConfigFile(string file)
    {
        _isEditSettingsMenuOpen = false;
        if (SelectedServer == null) return;

        try
        {
            var filePath = $"{_settings.ServerLibraryPath}\\{SelectedServer.Id}\\{file}";
            await JsRuntime.InvokeVoidAsync("sctOpenFile", filePath);
        }
        catch
        {
            await Modal.AlertAsync($"Opening '{file}' in external editor...", "Edit Settings");
        }
    }

    private async Task SaveServerSettings()
    {
        if (SelectedServer == null) return;
        await Modal.AlertAsync($"Settings for {SelectedServer.Name} have been saved successfully.", "Settings Saved", "💾");
    }

    private void ResetServerSettings()
    {
        if (SelectedServer == null) return;
        SelectedServer.ServerPort = 27015;
        SelectedServer.MaxPlayers = 16;
        SelectedServer.RunAsAdmin = false;
        SelectedServer.HighPriority = true;
        SelectedServer.EnableConsoleWindow = true;
        SelectedServer.AutoBackupBeforeLaunch = false;
        StateHasChanged();
    }

    private void OpenInstallationGuide()
    {
        if (SelectedServer == null) return;
        Modal.ShowGuide(SelectedServer.Name, SelectedServer.GuideContent);
    }

