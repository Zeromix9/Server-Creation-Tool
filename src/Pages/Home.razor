    private IEnumerable<ServerItem> FilteredServers
    {
        get
        {
            var query = _servers.AsEnumerable();
            if (_showFavoritesOnly) query = query.Where(s => s.IsFavorite);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(s => s.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    private void SelectWelcome()
    {
        _isWelcomeActive = true;
        _isInstanceMenuOpen = false;
    }

    private void SelectServer(ServerItem srv)
    {
        SelectedServer = srv;
        _isWelcomeActive = false;
        _isInstanceMenuOpen = false;
    }

    private bool _isReloading = false;

    private async Task ReloadServers()
    {
        _isReloading = true;
        InitializeServers();
        if (SelectedServer != null)
        {
            SelectedServer = _servers.FirstOrDefault(s => s.Id == SelectedServer.Id) ?? _servers.FirstOrDefault();
        }
        await Task.Delay(200);
        _isReloading = false;
    }

    private void ToggleFavoritesFilter() => _showFavoritesOnly = !_showFavoritesOnly;

    private void ToggleFavorite()
    {
        if (SelectedServer != null) SelectedServer.IsFavorite = !SelectedServer.IsFavorite;
    }

    private async Task ToggleMorePanel()
    {
        _isMoreOpen = !_isMoreOpen;
        try
        {
            var targetWidth = _isMoreOpen ? 930.0 : 820.0;
            await JsRuntime.InvokeVoidAsync("sctAnimateWindowWidth", targetWidth, 350);
        }
        catch { }
    }

    private void ToggleInstanceMenu()
    {
        _isLangMenuOpen = false;
        _isSteamCmdMenuOpen = false;
        _isEditSettingsMenuOpen = false;
        _isInstanceMenuOpen = !_isInstanceMenuOpen;
    }

    private void SwitchInstance(string inst)
    {
        if (SelectedServer != null)
        {
            SelectedServer.CurrentInstance = inst;
            _isInstanceMenuOpen = false;
        }
    }

    private async Task AddNewInstance()
    {
        _isInstanceMenuOpen = false;
        if (SelectedServer == null) return;
        var newName = $"Instance #{SelectedServer.Instances.Count + 1}";
        SelectedServer.Instances.Add(newName);
        SelectedServer.CurrentInstance = newName;
        await Modal.AlertAsync($"New instance '{newName}' created for {SelectedServer.Name}.", "Instance Created");
    }

    private void AppendTerminalLine(ServerItem server, string message)
    {
        var line = $"[{DateTime.Now:HH:mm:ss}] {message}";
        server.TerminalOutput = string.IsNullOrEmpty(server.TerminalOutput)
            ? line
            : $"{server.TerminalOutput}\n{line}";
    }

    private async Task BackupServer()
    {
        if (SelectedServer == null) return;
        if (!SelectedServer.IsInstalled)
        {
            await Modal.AlertAsync("Cannot backup a server that is not installed.", "Backup Server", "⚠️");
            return;
        }
        var backupName = $"{SelectedServer.Id}_{SelectedServer.CurrentInstance.Replace(" ", "_")}_{DateTime.Now:yyyyMMdd_HHmm}.zip";
        await Modal.AlertAsync($"Backup archive created successfully:\n{_settings.ServerLibraryPath}\\backups\\{backupName}", "Server Backup", "💾");
    }

    private async Task RestoreBackup()
    {
        if (SelectedServer == null) return;
        if (!SelectedServer.IsInstalled)
        {
            await Modal.AlertAsync("Cannot restore a backup to a server that is not installed.", "Restore Backup", "⚠️");
            return;
        }
        await Modal.AlertAsync($"Looking for backup archives in:\n{_settings.ServerLibraryPath}\\backups\n\nSelect an archive to restore.", "Restore Backup", "📦");
    }

    private async Task StartServer()
    {
        if (SelectedServer == null) return;
        if (SelectedServer.IsRunning)
        {
            SelectedServer.IsRunning = false;
            AppendTerminalLine(SelectedServer, $"Stopped {SelectedServer.Name} ({SelectedServer.CurrentInstance}).");
            await Modal.AlertAsync($"Server process for {SelectedServer.Name} ({SelectedServer.CurrentInstance}) stopped.", "Server Stopped", "⏹");
            return;
        }

        SelectedServer.IsRunning = true;
        SelectedServer.LastRan = DateTime.Now.ToString("dd/MM/yyyy");
        AppendTerminalLine(SelectedServer, $"Starting {SelectedServer.Name} ({SelectedServer.CurrentInstance})...");
        await Modal.AlertAsync($"Starting {SelectedServer.Name} ({SelectedServer.CurrentInstance})...\n\nServer process launched successfully.", "Server Started", "▶");
    }

    private async Task InstallServer()
    {
        if (SelectedServer == null) return;
        var confirmed = await Modal.ConfirmAsync($"Do you want to install {SelectedServer.Name} to '{_settings.ServerLibraryPath}'?", "Install Server", "📥");
        if (confirmed)
        {
            SelectedServer.IsInstalled = true;
            SelectedServer.LastUpdated = DateTime.Now.ToString("dd/MM/yyyy");
            AppendTerminalLine(SelectedServer, $"Installed {SelectedServer.Name} to {_settings.ServerLibraryPath}\\{SelectedServer.Id}.");
            await Modal.AlertAsync($"Installation completed successfully for {SelectedServer.Name}!", "Installed");
        }
    }

    private async Task UpdateOrRepair()
    {
        if (SelectedServer == null) return;
        var confirmed = await Modal.ConfirmAsync($"Validate and repair installation files for {SelectedServer.Name}?", "Update/Repair", "🔄");
        if (confirmed)
        {
            SelectedServer.LastUpdated = DateTime.Now.ToString("dd/MM/yyyy");
            AppendTerminalLine(SelectedServer, $"Validated and repaired files for {SelectedServer.Name}.");
            await Modal.AlertAsync($"Validation finished. All files for {SelectedServer.Name} are intact.", "Verification Complete");
        }
    }

    private async Task DeleteServer()
