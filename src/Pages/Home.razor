        var confirmed = await Modal.ConfirmAsync($"Are you sure you want to delete server files for {SelectedServer.Name}?", "Delete Confirmation", "⚠️", "Delete", "Cancel");
        if (confirmed)
        {
            SelectedServer.IsInstalled = false;
            AppendTerminalLine(SelectedServer, $"Removed {SelectedServer.Name} files from library.");
            await Modal.AlertAsync($"Server {SelectedServer.Name} removed from library.", "Deleted");
        }
