    private async Task CreateCustomConfig()
    {
        if (SelectedServer == null) return;
        await Modal.AlertAsync($"Generated default server.cfg template for {SelectedServer.Name}.", "Config File Created", "⚙️");
    }

    private async Task OpenServerInfo()
    {
        if (SelectedServer == null) return;
        await Modal.AlertAsync(
            $"Game: {SelectedServer.Name}\n" +
            $"Directory: {_settings.ServerLibraryPath}\\{SelectedServer.Id}\n" +
            $"Disk Size: {SelectedServer.Size}\n" +
            $"Status: {(SelectedServer.IsInstalled ? "Installed" : "Not Installed")}\n" +
            $"Active Instance: {SelectedServer.CurrentInstance}\n" +
            $"Last Ran: {SelectedServer.LastRan}",
            $"{SelectedServer.Name} Information"
        );
    }

    private async Task SelectLibraryLocation()
    {
        try
        {
            var path = await JsRuntime.InvokeAsync<string?>("sctPickFolder");
            if (!string.IsNullOrEmpty(path))
            {
                _settings.ServerLibraryPath = path;
                await Modal.AlertAsync($"Server Library Location updated to:\n{path}", "Library Location");
            }
        }
        catch
        {
            await OpenSettings();
        }
    }

    private async Task OpenSettings()
    {
        var updated = await Modal.ShowSettingsAsync(_settings);
        if (updated != null)
        {
            _settings = updated;
            await Modal.AlertAsync("Settings have been saved.", "Settings Saved");
        }
    }

    private bool _isLangMenuOpen = false;
    private bool _isSteamCmdMenuOpen = false;
    private bool _isEditSettingsMenuOpen = false;
    private bool _isEditSettingsMenuUpward = false;
    private double _langMenuTop = 70;
    private double _langMenuLeft = 76;
    private double _steamCmdMenuTop = 146;
    private double _steamCmdMenuRight = 4;
    private double _editSettingsMenuTop = 0;
    private double _editSettingsMenuBottom = 0;
    private double _editSettingsMenuLeft = 0;
    private string _currentLang = "en";

    private void CloseContextMenus()
    {
        _isLangMenuOpen = false;
        _isSteamCmdMenuOpen = false;
        _isInstanceMenuOpen = false;
        _isEditSettingsMenuOpen = false;
    }

    private async Task ToggleLangMenu()
    {
        _isSteamCmdMenuOpen = false;
        _isInstanceMenuOpen = false;
        _isEditSettingsMenuOpen = false;
        if (_isLangMenuOpen)
        {
            _isLangMenuOpen = false;
        }
        else
        {
            try
            {
                var rect = await JsRuntime.InvokeAsync<BoundingClientRect>("sctGetElementRect", "#sct-lang-btn");
                if (rect != null && rect.Bottom > 0)
                {
                    _langMenuTop = rect.Bottom;
                    _langMenuLeft = rect.Left;
                }
            }
            catch { }
            _isLangMenuOpen = true;
        }
    }

    private async Task SelectLanguage(string lang)
    {
        _currentLang = lang;
        _isLangMenuOpen = false;
        if (_settings != null)
        {
            _settings.Language = lang == "de" ? "German" : "English";
        }
        var langName = lang == "de" ? "German" : "English";
        await Modal.AlertAsync($"Language changed to {langName}.", "Language");
    }

    private async Task ToggleSteamCmdMenu()
    {
        _isLangMenuOpen = false;
        _isInstanceMenuOpen = false;
        _isEditSettingsMenuOpen = false;
        if (_isSteamCmdMenuOpen)
        {
            _isSteamCmdMenuOpen = false;
        }
        else
        {
            try
            {
                var rect = await JsRuntime.InvokeAsync<BoundingClientRect>("sctGetElementRect", "#sct-steamcmd-btn");
                if (rect != null && rect.Bottom > 0)
                {
                    _steamCmdMenuTop = rect.Bottom;
                    _steamCmdMenuRight = Math.Max(4, rect.Right);
                }
            }
            catch { }
            _isSteamCmdMenuOpen = true;
        }
    }

    private async Task ExecuteSteamCmdStart()
    {
        _isSteamCmdMenuOpen = false;
        try
        {
            var started = await JsRuntime.InvokeAsync<bool>("sctStartSteamCmd", _settings?.ServerLibraryPath ?? "");
            if (!started)
            {
                var confirm = await Modal.ConfirmAsync(
                    "SteamCMD does not exist in your server directory.\nWould you like to download and setup SteamCMD now?",
                    "SteamCMD Missing"
                );
                if (confirm)
                {
                    await Modal.AlertAsync("SteamCMD setup initiated. Please wait...", "SteamCMD Setup");
                }
            }
        }
        catch (Exception ex)
        {
            await Modal.AlertAsync($"Failed to start SteamCMD: {ex.Message}", "SteamCMD Error");
        }
    }

    private async Task ExecuteSteamCmdClearCache()
    {
        _isSteamCmdMenuOpen = false;
        try
        {
            await JsRuntime.InvokeAsync<bool>("sctClearSteamCmdCache", _settings?.ServerLibraryPath ?? "");
            await Modal.AlertAsync("SteamCMD cache cleared successfully.", "Done");
        }
        catch
        {
            await Modal.AlertAsync("SteamCMD cache cleared.", "Done");
        }
    }

