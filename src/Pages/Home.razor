                <button class="sct-side-btn" @onclick='() => OpenLink("https://github.com/Zeromix9/Server-Creation-Tool")'>
                    <img src="img/icons/github_logo.png" class="sct-side-btn-icon" alt="" />
                    <span class="sct-side-btn-text">Github</span>
