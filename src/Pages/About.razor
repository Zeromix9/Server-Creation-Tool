@page "/about"
@inject IJSRuntime JSRuntime

<div class="sct-window-frame sct-about-window">
    <!-- Top Titlebar: Following Main Form Titlebar Style -->
    <div id="sct-titlebar" class="sct-titlebar">
        <div class="sct-titlebar-left">
            <img class="sct-titlebar-icon sct-about-titlebar-icon" src="img/icons/219116.png" alt="About Icon" />
            <span class="sct-titlebar-title">About Server Creation Tool</span>
        </div>
        <div class="sct-titlebar-controls" @onmousedown:stopPropagation="true">
            <button type="button" class="sct-win-btn sct-win-btn-close" @onclick="CloseWindow" title="Close" aria-label="Close"></button>
        </div>
    </div>

    <!-- Main Window Middle with WinForms Docked 10px Borders -->
    <div class="sct-window-inner">
        <!-- Docked Left 10px Gradient Border (WinForms panel4) -->
        <div class="sct-border-left"></div>

        <!-- Center Working Canvas (About Client Area) -->
        <div class="sct-about-client">
            <!-- Header section with author info and developers -->
            <div class="sct-about-header">
                <!-- Left Author Block -->
                <div class="sct-about-author-block">
                    <div class="sct-about-creator-title">
                        This Tool was created by <span class="sct-about-highlight">Zeromix</span>
                    </div>
                    <div class="sct-about-links-row">
                        <button type="button" class="sct-about-link-btn" @onclick='() => OpenUrl("https://steamcommunity.com/id/zeromix/")'>
                            <span class="sct-link-icon">🎮</span> Steam Profile
                        </button>
                        <button type="button" class="sct-about-link-btn" @onclick='() => OpenUrl("https://www.youtube.com/channel/UCA5MGs8_on46jz-e5HZoTPQ")'>
                            <span class="sct-link-icon">📺</span> YouTube Channel
                        </button>
                    </div>
                </div>

                <!-- Vertical Divider -->
                <div class="sct-about-divider"></div>

                <!-- Right Developers Block -->
                <div class="sct-about-devs-block">
                    <div class="sct-about-section-subtitle">Developers</div>
                    <div class="sct-about-devs-row">
                        <span class="sct-about-dev-name">BasisBit</span>
                        <span class="sct-about-dev-sep">,</span>
                        <button type="button" class="sct-about-dev-link" @onclick='() => OpenUrl("https://steamcommunity.com/profiles/76561198351612219")'>
                            cookieoreo18
                        </button>
                        <span class="sct-about-dev-sep">,</span>
                        <span class="sct-about-dev-name">Zeromix</span>
                    </div>
                </div>
            </div>

            <!-- Changelog Section -->
            <div class="sct-about-changelog-section">
                <div class="sct-about-changelog-header">
                    <span class="sct-about-changelog-label">ChangeLog</span>
                    <span class="sct-about-badge">Version 5.2</span>
                </div>
                <div class="sct-about-changelog-box">
                    @foreach (var entry in _changelogEntries)
                    {
                        <div class="sct-changelog-card">
                            <div class="sct-changelog-card-header">@entry.Header</div>
                            @if (entry.Items.Any())
                            {
                                <ul class="sct-changelog-card-list">
                                    @foreach (var item in entry.Items)
                                    {
                                        <li>@item.TrimStart('-', ' ')</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Docked Right 10px Gradient Border (WinForms panel3) -->
        <div class="sct-border-right"></div>
    </div>

    <!-- Docked Bottom 10px Gradient Border (WinForms panel2) -->
    <div class="sct-border-bottom"></div>
</div>

@code {
    private class ChangelogEntry
    {
        public string Header { get; set; } = string.Empty;
        public List<string> Items { get; set; } = new();
    }

    private List<ChangelogEntry> _changelogEntries = new();

    protected override void OnInitialized()
    {
        var blocks = ChangelogText.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
        foreach (var block in blocks)
        {
            var lines = block.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length > 0)
            {
                var entry = new ChangelogEntry
                {
                    Header = lines[0].Trim(),
                    Items = lines.Skip(1).Select(l => l.Trim()).ToList()
                };
                _changelogEntries.Add(entry);
            }
        }
    }

    private async Task CloseWindow()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sctCloseWindow");
        }
        catch { }
    }

    private async Task OpenUrl(string url)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("sctOpenUrl", url);
        }
        catch { }
    }

