@inject ModalService Modal
@inject IJSRuntime JsRuntime
@implements IDisposable

@if (Modal.IsOpen)
{
    <div class="sct-modal-backdrop" @onclick="OnBackdropClick">
        <div class="sct-window-frame sct-modal-window @GetModalClass() @(_isFlashing ? "sct-modal-flash" : "")" @onclick:stopPropagation="true">
            <!-- Top Titlebar: Authentic WinForms MainForm Style -->
            <div class="sct-titlebar">
                <div class="sct-titlebar-left">
                    <img class="sct-titlebar-icon sct-modal-titlebar-icon" src="@GetModalIcon()" alt="" />
                    <span class="sct-titlebar-title">@GetModalTitle()</span>
                </div>
                <div class="sct-titlebar-controls" @onmousedown:stopPropagation="true">
                    <button type="button" class="sct-win-btn sct-win-btn-close" @onclick="CloseCurrentModal" title="Close" aria-label="Close"></button>
                </div>
            </div>

            <!-- Window Inner: Docked Left & Right 10px Gradient Borders -->
            <div class="sct-window-inner">
                <!-- Left 10px Gradient Border (panel4) -->
                <div class="sct-border-left"></div>

                <!-- Modal Content Area -->
                <div class="sct-modal-client">
                    @if (Modal.AlertVisible)
                    {
                        <div class="sct-modal-body sct-msgbox-body">
                            <div class="sct-msgbox-row">
                                <span class="sct-msgbox-icon">@Modal.AlertIcon</span>
                                <div class="sct-msgbox-text">@Modal.AlertMessage</div>
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseAlert()">OK</button>
                        </div>
                    }
                    else if (Modal.ConfirmVisible)
                    {
                        <div class="sct-modal-body sct-msgbox-body">
                            <div class="sct-msgbox-row">
                                <span class="sct-msgbox-icon">@Modal.ConfirmIcon</span>
                                <div class="sct-msgbox-text">@Modal.ConfirmMessage</div>
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseConfirm(true)">@Modal.ConfirmOkLabel</button>
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseConfirm(false)">@Modal.ConfirmCancelLabel</button>
                        </div>
                    }
                    else if (Modal.SettingsVisible && Modal.TempSettings != null)
                    {
                        <div class="sct-modal-body" style="display: flex; flex-direction: column; gap: 14px;">
                            <div>
                                <label class="sct-field-label">Server Library Location:</label>
                                <div style="display: flex; gap: 6px; margin-top: 4px;">
                                    <input type="text" class="sct-input" style="flex: 1;" @bind="Modal.TempSettings.ServerLibraryPath" />
                                    <button type="button" class="sct-btn" style="padding: 4px 10px;" @onclick="PickLibraryPath">Browse...</button>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 4px;">
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; cursor: pointer;">
                                    <input type="checkbox" @bind="Modal.TempSettings.AutoCheckUpdates" />
                                    Automatically check for updates on startup
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; cursor: pointer;">
                                    <input type="checkbox" @bind="Modal.TempSettings.CloseToTray" />
                                    Minimize to system tray when closing
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; font-size: 12px; cursor: pointer;">
                                    <input type="checkbox" @bind="Modal.TempSettings.RunSteamCmdMinimized" />
                                    Run SteamCMD in background / minimized
                                </label>
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseSettings(true)">Save Settings</button>
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseSettings(false)">Cancel</button>
                        </div>
                    }
                    else if (Modal.AboutVisible)
                    {
                        <div class="sct-modal-body" style="text-align: center; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                            <img src="img/servers/toolIcon(1).png" style="width: 56px; height: 56px;" alt="Logo" />
                            <div style="font-size: 15px; font-weight: 700; color: #38bdf8;">Server Creation Tool 5.2</div>
                            <div style="font-size: 12px; color: #94a3b8; max-width: 320px; line-height: 1.4;">
                                A fast, lightweight tool to install, configure and manage dedicated game servers.
                            </div>
                            <div style="font-size: 11px; color: #64748b; margin-top: 4px;">
                                Created by <strong>Zeromix</strong> • Modernized UI
                            </div>
                            <div style="display: flex; gap: 8px; margin-top: 8px;">
                                <button type="button" class="sct-btn" style="font-size: 11px;" @onclick='() => OpenLink("https://steamcommunity.com/groups/ServerTool")'>Steam Group</button>
                                <button type="button" class="sct-btn" style="font-size: 11px;" @onclick='() => OpenLink("https://discord.gg/79eKCs5fW8")'>Discord</button>
                                <button type="button" class="sct-btn" style="font-size: 11px;" @onclick='() => OpenLink("https://github.com/Zeromix9/Server-Creation-Tool")'>GitHub</button>
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseAbout()">Close</button>
                        </div>
                    }
                    else if (Modal.GuideVisible)
                    {
                        <div class="sct-modal-body" style="max-height: 320px; overflow-y: auto;">
                            <div style="white-space: pre-wrap; font-size: 12px; line-height: 1.6; color: #cbd5e1; background: #16202e; padding: 12px; border-radius: 4px; border: 1px solid #2d3f58;">
                                @Modal.GuideText
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseGuide()">Done</button>
                        </div>
                    }
                    else if (Modal.FaqVisible)
                    {
                        <div class="sct-modal-body sct-faq-body">
                            @foreach (var item in _faqEntries)
                            {
                                <div class="sct-faq-item">
                                    <div class="sct-faq-question">
                                        <span class="sct-faq-arrow">&#10148;</span>
                                        <span class="sct-faq-q-text">@item.Question</span>
                                    </div>
                                    <div class="sct-faq-answer">
                                        <span>@item.Answer</span>@if (!string.IsNullOrEmpty(item.LinkLabel) && !string.IsNullOrEmpty(item.LinkUrl))
                                        {
                                            <text> </text><a href="#" class="sct-link" @onclick='() => OpenLink(item.LinkUrl)' @onclick:preventDefault>@item.LinkLabel</a>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="sct-faq-help">
                                <div>If you have any more questions or need any help, join our discord server or steam group.</div>
                                <div class="sct-faq-links">
                                    <a href="#" class="sct-link" @onclick='() => OpenLink("https://discord.gg/79eKCs5fW8")' @onclick:preventDefault>Discord Server</a>
                                    <a href="#" class="sct-link" @onclick='() => OpenLink("https://steamcommunity.com/groups/ServerTool")' @onclick:preventDefault>Steam Group</a>
                                </div>
                            </div>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseFaq()">OK</button>
                        </div>
                    }
                    else if (Modal.SteamCmdOptionsVisible)
                    {
                        <div class="sct-modal-body" style="display: flex; flex-direction: column; gap: 10px;">
                            <button type="button" class="sct-btn" style="text-align: left; padding: 8px 12px;" @onclick='() => Modal.AlertAsync("SteamCMD validated successfully and is up-to-date.", "SteamCMD Update")'>
                                🔄 Force SteamCMD Update &amp; Validation
                            </button>
                            <button type="button" class="sct-btn" style="text-align: left; padding: 8px 12px;" @onclick='() => Modal.AlertAsync("SteamCMD cache and temporary downloads cleared.", "Clear Cache")'>
                                🧹 Clear SteamCMD Cache &amp; Temp Files
                            </button>
                            <button type="button" class="sct-btn" style="text-align: left; padding: 8px 12px;" @onclick='() => Modal.AlertAsync("Opening SteamCMD interactive console window...", "SteamCMD Terminal")'>
                                💻 Open SteamCMD Interactive Console
                            </button>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseSteamCmdOptions()">Close</button>
                        </div>
                    }
                    else if (Modal.EditSettingsVisible)
                    {
                        <div class="sct-modal-body" style="display: flex; flex-direction: column; gap: 8px;">
                            <div style="font-size: 12px; color: #94a3b8; margin-bottom: 4px;">Select configuration file to open/edit:</div>
                            @foreach (var file in Modal.EditSettingsFiles)
                            {
                                <button type="button" class="sct-btn" style="text-align: left; padding: 8px 12px; display: flex; justify-content: space-between; align-items: center;" @onclick='() => OpenConfigFile(file)'>
                                    <span>📄 @file</span>
                                    <span style="font-size: 10px; color: #38bdf8;">Open in Notepad ↗</span>
                                </button>
                            }
                            <button type="button" class="sct-btn" style="text-align: left; padding: 8px 12px; margin-top: 4px;" @onclick='() => Modal.AlertAsync("Default configuration files restored.", "Reset Config")'>
                                🔄 Restore Default Configuration
                            </button>
                        </div>
                        <div class="sct-modal-footer">
                            <button type="button" class="sct-btn" @onclick="() => Modal.CloseEditSettings()">Close</button>
                        </div>
                    }
                </div>

                <!-- Right 10px Gradient Border (panel3) -->
                <div class="sct-border-right"></div>
            </div>

            <!-- Bottom 10px Gradient Border (panel2) -->
            <div class="sct-border-bottom"></div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Modal.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Modal.OnChange -= StateHasChanged;
    }

    private string GetModalTitle()
    {
        if (Modal.AlertVisible) return string.IsNullOrWhiteSpace(Modal.AlertTitle) ? "Information" : Modal.AlertTitle;
        if (Modal.ConfirmVisible) return string.IsNullOrWhiteSpace(Modal.ConfirmTitle) ? "Confirm" : Modal.ConfirmTitle;
        if (Modal.SettingsVisible) return "Settings";
        if (Modal.AboutVisible) return "About Server Creation Tool";
        if (Modal.FaqVisible) return "FAQ - Frequently Asked Questions";
        if (Modal.GuideVisible) return $"Installation Guide: {Modal.GuideTitle}";
        if (Modal.SteamCmdOptionsVisible) return "SteamCMD Options";
        if (Modal.EditSettingsVisible) return $"Edit Settings: {Modal.EditSettingsGame}";
        return "Server Creation Tool";
    }

    private string GetModalIcon()
    {
        if (Modal.SettingsVisible || Modal.EditSettingsVisible) return "img/icons/settingsBtn.Image.png";
        if (Modal.AboutVisible) return "img/icons/219116.png";
        if (Modal.FaqVisible) return "img/icons/faqBtn.Image.png";
        if (Modal.GuideVisible) return "img/icons/1091.png";
        if (Modal.SteamCmdOptionsVisible) return "img/icons/SquaregreenArrowRight.png";
        return "img/icons/icons8-server-24.png";
    }

    private string GetModalClass()
    {
        if (Modal.AlertVisible || Modal.ConfirmVisible) return "sct-modal-msgbox";
        if (Modal.SettingsVisible) return "sct-modal-settings";
        if (Modal.FaqVisible) return "sct-modal-faq";
        if (Modal.GuideVisible) return "sct-modal-guide";
        if (Modal.EditSettingsVisible) return "sct-modal-editsettings";
        if (Modal.SteamCmdOptionsVisible) return "sct-modal-steamcmd";
        if (Modal.AboutVisible) return "sct-modal-about-fallback";
        return "";
    }

    private void CloseCurrentModal()
    {
        if (Modal.AlertVisible) Modal.CloseAlert();
        else if (Modal.ConfirmVisible) Modal.CloseConfirm(false);
        else if (Modal.SettingsVisible) Modal.CloseSettings(false);
        else if (Modal.AboutVisible) Modal.CloseAbout();
        else if (Modal.FaqVisible) Modal.CloseFaq();
        else if (Modal.GuideVisible) Modal.CloseGuide();
        else if (Modal.SteamCmdOptionsVisible) Modal.CloseSteamCmdOptions();
        else if (Modal.EditSettingsVisible) Modal.CloseEditSettings();
    }

    private bool _isFlashing = false;

    private async Task OnBackdropClick()
    {
        // Desktop Windows behavior: modal dialogs never close on outside click.
        if (_isFlashing) return;
        _isFlashing = true;
        StateHasChanged();
        await Task.Delay(380);
        _isFlashing = false;
        StateHasChanged();
    }

    private async Task PickLibraryPath()
    {
        try
        {
            var picked = await JsRuntime.InvokeAsync<string?>("sctPickFolder");
            if (!string.IsNullOrEmpty(picked) && Modal.TempSettings != null)
            {
                Modal.TempSettings.ServerLibraryPath = picked;
            }
        }
        catch
        {
            // Browser fallback
        }
    }

    private async Task OpenLink(string url)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("sctOpenUrl", url);
        }
        catch
        {
            await JsRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }

    private async Task OpenConfigFile(string file)
    {
        await Modal.AlertAsync($"Opening '{file}' in external editor...", "Config File");
    }

    private sealed record FaqEntry(string Question, string Answer, string? LinkLabel = null, string? LinkUrl = null);

    private static readonly FaqEntry[] _faqEntries =
    [
        new(
            "I can not see my server / No one can connect to my server",
            "Please make sure, that you have opened all the required ports in your router.\n" +
            "If everything is set correctly, but the problem still occurs, please contact your internet provider.\n" +
            "Or look for your router model here:",
            "Click here",
            "https://portforward.com/router.htm"
        ),
        new(
            "Is there another way instead of opening the ports?",
            "Yes, you can also host your server through a VPN network like \"Hamachi\".\n" +
            "Of course only the people in the VPN network will be able to join the server then.\n" +
            "If forwarding your ports doesn´t work, please contact your ISP, i won´t be able to help you."
        ),
        new(
            "The SteamCMD download failed! What should I do now?",
            "Mostly you just need to retry the download, then the problem should be fixed."
        ),
        new(
            "How do I update my server?",
            "Just click on the \"Update\\Repair\" button, the server will automatically update."
        )
    ];
}
